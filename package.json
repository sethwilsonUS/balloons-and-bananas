{
  "name": "balloons-and-bananas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:build-output": "node scripts/check-build-output.mjs",
    "test:e2e": "ARCHIVE_LOCAL_DATA=tests/fixtures/archive.json ARCHIVE_LOCAL_ASSETS_DIR=tests/fixtures/files VERCEL='' npm run build && node scripts/check-build-output.mjs && playwright test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.8.0",
    "botid": "1.5.11",
    "lucide-react": "^0.577.0",
    "minisearch": "7.2.0",
    "next": "16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
